directive @key(fields: String!) on OBJECT | INTERFACE

type Query {
  _empty: String
}

type Mutation {
  createStory(name: String!): Story
  deleteStory(id: ID!): Boolean
}

type Story @key(fields: "id") {
  id: ID!
  name: String!
  owner: String!
}

type Estimation @key(fields: "id") {
  id: ID!
  owner: String!
  complexity: Int!
  reach: Int!
  story: Story!
  dimensions: Int!
  risk: Int!
  interaction: Int!
}

extend type Query {
  stories: [Story]
  estimations: [Estimation]
}
