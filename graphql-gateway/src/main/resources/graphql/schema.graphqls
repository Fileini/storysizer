directive @key(fields: String!) on OBJECT | INTERFACE

type Query {
  stories: [Story]
  estimations: [Estimation]
}

type Mutation {
  createStory(name: String!): Story
  createEstimation(
    name: String!,
    complexity: Int!,
    reach: Int!,
    dimensions: Int!,
    risk: Int!,
    interaction: Int!,
    storyId: String!
  ): Estimation
  deleteStory(id: ID!): Boolean
  deleteEstimation(id: ID!): Boolean
}

type Story @key(fields: "id") {
  id: ID!
  name: String!
  owner: String!
}

type Estimation @key(fields: "id") {
  id: ID!
  owner: String!
  complexity: Int!
  reach: Int!
  story: Story!
  dimensions: Int!
  risk: Int!
  interaction: Int!
  sizer: Int
}
